---
import Item from '~/components/blog/ListItem.astro';
import CardBlog from '@/components/ui/cards/CardBlog.astro';
import Headline from '~/components/blog/Headline.astro';
import WidgetWrapper from '~/components/WidgetWrapper.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { Post } from '~/types';

interface Props {
	title: string;
	subTitle: string;
	posts: Array<Post>;
	id?: string;
	isDark?: boolean;
	classes?: { container?: string };
	bg?: any;
}

const {
	title = await Astro.slots.render('title'),
	subTitle = await Astro.slots.render('subTitle'),
	posts,
	id,
	isDark = false,
	classes = {},
	bg = await Astro.slots.render('bg')
} = Astro.props;

const englishBlogEntries = await getCollection('blogs', ({ id }) => {
	return id.startsWith('en/');
});

const blogPosts: CollectionEntry<'blogs'>[] = englishBlogEntries.sort(
	(a: CollectionEntry<'blogs'>, b: CollectionEntry<'blogs'>) =>
		b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const mostRecentPosts: CollectionEntry<'blogs'> = blogPosts.slice(0, 2);
---

<WidgetWrapper
	id={id}
	isDark={isDark}
	containerClass={`max-w-7xl ${classes?.container ?? ''}`}
	bg={bg}>
	<Headline subtitle={subTitle}>
		{title}
	</Headline>
	<div class='grid gap-6 lg:grid-cols-2'>
		{mostRecentPosts.map(blogEntry => <CardBlog blogEntry={blogEntry} />)}
	</div>
</WidgetWrapper>
