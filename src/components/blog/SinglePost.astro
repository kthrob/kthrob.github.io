---
import AvatarBlogLarge from '@/components/ui/avatars/AvatarBlogLarge.astro';
import { Icon } from 'astro-icon/components';

import Bookmark from '@/components/ui/buttons/Bookmark.astro';
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
// import SocialShare from '~/components/common/SocialShare.astro';
import PostFeedback from '@/components/ui/feedback/PostFeedback.astro';
import SocialShare from '@/components/ui/buttons/SocialShare_Custom.astro';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import WidgetWrapper from '~/components/WidgetWrapper.astro';
import type { Post } from '~/types';

export interface Props {
	post: Post;
	url: string | URL;
	id?: string;
	isDark?: boolean;
	classes?: { container?: string };
	bg?: any;
}

const {
	post,
	url,
	id,
	isDark = false,
	classes = {},
	bg = await Astro.slots.render('bg')
} = Astro.props;
---

<!-- <section class='py-8 sm:py-16 lg:py-20 mx-auto'> -->
<WidgetWrapper
	id={id}
	isDark={isDark}
	containerClass={`max-w-3xl ${classes?.container ?? ''}`}
	bg={bg}>
	<article>
		<header
			class={post.data.image
				? 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
				: 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'}>
			<div
				class='flex justify-between flex-col sm:flex-row max-w-3xl mx-auto mt-0 mb-2 sm:items-center text-text-default'>
				<p>
					<time
						datetime={String(post.data.publishDate)}
						class='inline-block'
						>{getFormattedDate(post.data.publishDate)}</time
					>
					{
						post.data.category && (
							<>
								&nbsp;·&nbsp;
								<a
									class='hover:underline inline-block'
									href={getPermalink(
										post.data.category.slug,
										'category'
									)}>
									{post.data.category.title}
								</a>
							</>
						)
					}
					{
						post.data.readingTime && (
							<>
								&nbsp;·&nbsp;
								<span>{post.data.readingTime}</span> min read
							</>
						)
					}
				</p>
			</div>

			<h1
				class='max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-text-default'>
				{post.data.title}
			</h1>
			<p
				class='max-w-3xl mx-auto mt-4 mb-8 text-xl md:text-2xl text-muted dark:text-slate-400 text-justify'>
				{post.data.excerpt}
			</p>
			<div class='flex flex-wrap items-center gap-2 mb-8'>
				<span class='w-8 h-px bg-stone-200'></span>
				<PostTags
					tags={post.data.tags}
					class='mr-5 rtl:mr-0 rtl:ml-5'
				/>
			</div>
			{
				post.data.image ? (
					<Image
						src={post.data.image}
						class='max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700'
						widths={[400, 900]}
						sizes='(max-width: 900px) 400px, 900px'
						alt={post?.data.excerpt || ''}
						width={900}
						height={506}
						loading='eager'
						decoding='async'
					/>
				) : (
					<div class='max-w-3xl mx-auto px-4 sm:px-6'>
						<div class='border-t dark:border-slate-700' />
					</div>
				)
			}
		</header>
		<div
			class='prose prose-md lg:prose-xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0 text-text-default'>
			<slot />
		</div>
		<div
			class='mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row'>
			<Bookmark />
			{
				post.data.author && (
					<>
						<AvatarBlogLarge blogEntry={post} />
						<span class='inline-block text-text-default'>
							{post.data.author}
						</span>
					</>
				)
			}
			<SocialShare pageTitle={post.data.title} />
			<!-- <SocialShare
				url={url}
				text={post.data.title}
				class='mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600'
			/> -->
			<PostFeedback
				title='Was this post helpful?'
				firstChoice='Yes'
				secondChoice='No'
			/>
		</div>
	</article>
</WidgetWrapper>
<!-- </section> -->
