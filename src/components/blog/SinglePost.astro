---
import AvatarBlogLarge from '@/components/ui/avatars/AvatarBlogLarge.astro';
import { Icon } from 'astro-icon/components';

import Bookmark from '@/components/ui/buttons/Bookmark.astro';
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
// import SocialShare from '~/components/common/SocialShare.astro';
import PostFeedback from '@/components/ui/feedback/PostFeedback.astro';
import SocialShare from '@/components/ui/buttons/SocialShare_Custom.astro';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import WidgetWrapper from '~/components/WidgetWrapper.astro';
import PostHeader from './PostHeader.astro';
import type { Post } from '~/types';

export interface Props {
	post: Post;
	url: string | URL;
	id?: string;
	isDark?: boolean;
	classes?: { container?: string };
	bg?: any;
}

const {
	post,
	url,
	id,
	isDark = false,
	classes = {},
	bg = await Astro.slots.render('bg')
} = Astro.props;
---

<!-- <section class='py-8 sm:py-16 lg:py-20 mx-auto'> -->
<WidgetWrapper
	id={id}
	isDark={isDark}
	containerClass={`max-w-3xl ${classes?.container ?? ''}`}
	bg={bg}>
	<article>
		<PostHeader post={post} />
		<div
			class='prose prose-md lg:prose-xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0 text-text-default'>
			<slot />
		</div>
		<div
			class='mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row'>
			<Bookmark />
			{
				post.data.author && (
					<>
						<AvatarBlogLarge blogEntry={post} />
						<span class='inline-block text-text-default'>
							{post.data.author}
						</span>
					</>
				)
			}
			<SocialShare pageTitle={post.data.title} />
			<!-- <SocialShare
				url={url}
				text={post.data.title}
				class='mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600'
			/> -->
			<PostFeedback
				title='Was this post helpful?'
				firstChoice='Yes'
				secondChoice='No'
			/>
		</div>
	</article>
</WidgetWrapper>
<!-- </section> -->
