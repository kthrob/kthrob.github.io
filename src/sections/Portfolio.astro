---
import { getPortafolioData } from '../components/data/portfolioData.js';
import Card from '~/components/sections/portfolio/card-portfolio/CardPortfolio.astro';
import WidgetWrapper from '~/components/WidgetWrapper.astro';
import Headline from '~/components/Headline.astro';

const {
	title = await Astro.slots.render('title'),
	subtitle = await Astro.slots.render('subtitle'),
	tagline = await Astro.slots.render('tagline'),
	items = [],
	columns = 2,

	defaultIcon,

	id,
	isDark = false,
	classes = {},
	bg = await Astro.slots.render('bg')
} = Astro.props;
---

<!-- <section
	id="portafolio"
	class="flex flex-col w-full  justify-center items-center h-auto min-h-[100dvh]  "
> -->
<WidgetWrapper
	id={id}
	isDark={isDark}
	containerClass={`max-w-7xl ${classes?.container ?? ''}`}
	bg={bg}>
  <Headline {title} {subtitle} {tagline} classes={{ container: classes?.headline ?? '' }} />
	<div class='portfolio__container'>
		<div class='portfolio__elements'>
			{getPortafolioData.map(props => <Card {...props} />)}
		</div>
	</div>
</WidgetWrapper>
<!-- </section> -->

<style>
	.portfolio__elements {
		max-width: var(--max-width);
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 4rem;
	}
</style>

<script>
	import { getIMGAverageColor } from '~/utils/average-img-color';

	const $cards = document.querySelectorAll('[data-portfolio-card]');
	$cards.forEach(card => {
		const $container = card.querySelector<HTMLDivElement>(
			'[data-portfolio-container]'
		);
		const $img = card.querySelector<HTMLImageElement>('[data-portfolio-img]');
		if (!$img || !$container) return;

		const setBg = () => {
			const [rbgString] = getIMGAverageColor($img, 0.7);
			$container.style.background = rbgString;
		};
		setBg();
		$img.onload = setBg;
	});
</script>
