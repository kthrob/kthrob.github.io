---
import { getCollection } from 'astro:content';
import { getPortafolioData } from '~/components/data/portfolioData.js';
import Card from '~/components/sections/portfolio/card-portfolio/CardPortfolio.astro';
import WidgetWrapper from '~/components/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';

const {
	title = await Astro.slots.render('title'),
	subtitle = await Astro.slots.render('subtitle'),
	tagline = await Astro.slots.render('tagline'),
	items = [],
	columns = 2,

	defaultIcon,

	id,
	isDark = false,
	classes = {},
	bg = await Astro.slots.render('bg')
} = Astro.props;

const portfolioData = await getCollection('portfolio')
---

<WidgetWrapper
	id={id}
	isDark={isDark}
	containerClass={`max-w-7xl ${classes?.container ?? ''}`}
	bg={bg}>
  <Headline {title} {subtitle} {tagline} classes={{ container: classes?.headline ?? '' }} />
	<div class='portfolio__container'>
		<div class='portfolio__elements'>
			{portfolioData.map(portfolioData => <Card {...portfolioData.data} />)}
		</div>
	</div>
</WidgetWrapper>

<style>
	.portfolio__elements {
		max-width: var(--max-width);
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 4rem;
	}
</style>
