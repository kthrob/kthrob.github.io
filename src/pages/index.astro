---
import Layout from '~/layouts/Layout.astro';
import Layout_Custom from '~/layouts/Layout_Custom.astro';
import Hero from '~/components/sections/Hero.astro';
import Portfolio from '~/sections/Portfolio.astro';
import Resume from '~/components/sections/Resume.astro';
import Carousel from '~/components/sections/skills/Carousel.astro';

import { logos } from '~/components/data/logos';
---

<!-- <Layout title='Astro Resume Theme'>  -->
<Layout_Custom>
	<Hero />
	<Carousel tools={logos} />
	<Portfolio title="My Work" subtitle="Projects I've Done" tagline="A showcase of my work" />
	<Resume />
</Layout_Custom>
