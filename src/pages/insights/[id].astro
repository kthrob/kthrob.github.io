---
// Import section components
import { SITE } from 'promethic:config';
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

// Use `getStaticPaths` to generate static routes for generated pages on build
export async function getStaticPaths() {
	const insightPosts = await getCollection('insights', ({ id }) =>
		id.startsWith('en/')
	);
	return insightPosts.map(post => {
		const idWithoutLang = post.id.replace(/^en\//, ''); // Remove the "fr/" prefix
		return {
			params: { id: idWithoutLang },
			props: { post }
		};
	});
}

// Get the props for this page that define a specific insight post
const { post } = Astro.props;

const { Content } = await render(post);

const pageTitle: string = `${post.data.title} | ${SITE.title}`;
const metaDescription = post.data.description;
const ogTitle = `${post.data.title} | Insights | ${SITE.title}`;
---

<Layout>
	<section class='py-6 sm:py-8 lg:py-12'>
		<div class='mx-auto max-w-(--breakpoint-xl) px-4 md:px-8'>
			<div class='grid gap-8 md:grid-cols-2 lg:gap-12'>
				<div>
					<div
						class='h-64 overflow-hidden rounded-lg shadow-lg md:h-auto'>
						<Image
							class='h-full w-full object-cover object-center'
							src={post.data.cardImage}
							alt={post.data.cardImageAlt}
							draggable={'false'}
							format={'avif'}
						/>
					</div>
					<div
						id='progress-mobile'
						class='fixed top-0 left-0 h-2 w-full bg-linear-to-r from-orange-400/30 to-orange-400 md:hidden'>
					</div>
					<div
						id='pin'
						class='mt-10 hidden space-y-4 md:block'>
						<div
							class='h-px w-full overflow-hidden bg-neutral-300 dark:bg-neutral-700'>
							<div
								id='progress'
								class='h-px w-full bg-linear-to-r from-cyan-800/30 to-cyan-300'>
							</div>
						</div>
						<p class='text-sm text-pretty text-neutral-500'>
							Table of Contents:
						</p>
						<div
							id='toc'
							class=''>
							<ul
								class='space-y-2 text-base text-pretty text-neutral-700 transition duration-300 dark:text-neutral-400'>
							</ul>
						</div>
					</div>
				</div>

				<div class='md:pt-8'>
					<h1
						class='mb-4 text-center text-2xl font-bold text-balance text-neutral-800 sm:text-3xl md:mb-6 md:text-left dark:text-neutral-200'>
						{post.data.title}
					</h1>

					<article
						class='text-lg text-pretty text-neutral-700 dark:text-neutral-300'>
						<Content />
					</article>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style is:global>
	:root {
		--transition-cubic: cubic-bezier(0.165, 0.84, 0.44, 1);
	}

	html {
		scroll-behavior: smooth;
	}

	article h2,
	article h3,
	article h4,
	article h5,
	article h6 {
		font-weight: bold;
		margin-top: 2.5rem;
		scroll-margin-top: 3rem;
	}

	h2 {
		font-size: 1.5rem;
		line-height: 2rem;
	}

	h3 {
		font-size: 1.25rem;
		line-height: 1.75rem;
	}

	h4 {
		font-size: 1.125rem;
		line-height: 1.75rem;
	}

	p {
		margin-top: 1.5rem;
	}

	#toc li {
		display: flex;
		align-items: center;
		opacity: 0.8;
		transition: all 300ms var(--transition-cubic);
	}

	#toc li.selected {
		opacity: 1;
	}

	#toc li svg {
		width: 0;
		height: 0;
		transition:
			height 400ms var(--transition-cubic),
			width 400ms var(--transition-cubic);
	}

	#toc li.selected svg {
		width: 1.25rem;
		height: 1.25rem;
		margin-right: 0.3rem;
	}
</style>

<script>
	const initProgressBar = () => {
		const progressBar = document.getElementById('progress');
		const progressBarMobile = document.getElementById('progress-mobile');

		if (progressBar && progressBarMobile) {
			progressBar.style.width = '0%';
			progressBarMobile.style.width = '0%';
		}
	};

	const onScroll = (): void => {
		const article = document.querySelector('article');
		if (!article) return;

		const articleHeight = article.offsetHeight;
		const articleOffsetTop = article.offsetTop;

		const scrollTop = window.scrollY || document.documentElement.scrollTop;

		if (articleHeight && articleOffsetTop) {
			const progress = Math.max(
				0,
				Math.min(
					100,
					((scrollTop - articleOffsetTop) /
						(articleHeight - window.innerHeight)) *
						100
				)
			);

			const progressBar = document.getElementById('progress');
			const progressBarMobile =
				document.getElementById('progress-mobile');

			if (progressBar && progressBarMobile) {
				progressBar.style.width = `${progress}%`;
				progressBarMobile.style.width = `${progress}%`;
			}
		}
	};

	// Initialize immediately and on various load events
	initProgressBar();
	window.addEventListener('load', initProgressBar);
	document.addEventListener('DOMContentLoaded', initProgressBar);
	document.addEventListener('astro:page-load', initProgressBar);

	// Set up scroll handler
	window.addEventListener('scroll', onScroll);
	document.addEventListener('astro:page-load', () => {
		window.addEventListener('scroll', onScroll);
		onScroll(); // Check initial scroll position
	});
</script>
<script>
	// SVG icon for active ToC items
	const SVG_HTML_STRING =
		'<svg class="w-0 h-0 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#00F0FF"><path stroke-linecap="round" stroke-linejoin="round" d="m12.75 15 3-3m0 0-3-3m3 3h-7.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></svg>';

	// Track active heading ID
	let activeHeadingId: string | null = null;

	// Update active link in ToC
	function setActiveLinkById(id: string | null) {
		const listItems = document.querySelectorAll('#toc li');
		listItems.forEach(item => item.classList.remove('selected'));

		if (!id) return;

		const activeLink = document.querySelector(`#toc a[href="#${id}"]`);
		if (!activeLink) return;

		const listItem = activeLink.parentElement;
		listItem?.classList.add('selected');
		activeHeadingId = id;
	}

	function initializeToC() {
		// Get core elements
		const article: HTMLElement | null = document.querySelector('article');
		const tocList: HTMLElement | null = document.querySelector('#toc ul');
		const pinElement: HTMLElement | null = document.getElementById('pin');
		const footer: HTMLElement | null = document.querySelector('footer');

		if (!article || !tocList) {
			// If elements not found, try again after a short delay
			setTimeout(initializeToC, 100);
			return;
		}

		// Clear existing ToC items (in case of re-initialization)
		tocList.innerHTML = '';

		// Get all headings from article
		const headings: HTMLElement[] = Array.from(
			article.querySelectorAll('h1, h2, h3, h4, h5, h6')
		);

		if (headings.length === 0) {
			return; // No headings found
		}

		// Build ToC structure
		headings.forEach(heading => {
			if (heading instanceof HTMLElement && heading.id) {
				const listItem = document.createElement('li');
				listItem.className =
					'toc-level-' + heading.tagName.toLowerCase();

				// Add SVG icon
				const tempDiv = document.createElement('div');
				tempDiv.innerHTML = SVG_HTML_STRING;
				const svg = tempDiv.firstChild;
				listItem.appendChild(svg as Node);

				// Add link
				const link = document.createElement('a');
				link.href = '#' + heading.id;
				link.textContent = heading.textContent;
				listItem.appendChild(link);

				tocList.appendChild(listItem);
			}
		});

		// Add placeholder div after article to ensure last heading can be properly highlighted
		const placeholder = document.createElement('div');
		placeholder.id = 'article-end-placeholder';
		placeholder.style.height = '30vh'; // Just enough space for last section to reach trigger point
		placeholder.style.visibility = 'hidden';
		article.appendChild(placeholder);

		// Use CSS sticky positioning instead of complex JS pinning
		if (pinElement) {
			// Apply sticky positioning
			pinElement.style.position = 'sticky';
			pinElement.style.top = '20vh'; // 20vh from top - this is our universal trigger point
			pinElement.style.alignSelf = 'flex-start';
			pinElement.style.zIndex = '10';
		}

		// Comprehensive ToC highlighting system
		let activeHeading: HTMLElement | null = null;
		let isUserScrolling = true; // Start as true to prevent initial highlighting
		let scrollTimeout: number;
		let clickTimeout: number;

		// Calculate which heading should be active based on scroll position
		function calculateActiveHeading(): HTMLElement | null {
			// Use 20vh as trigger point to match ToC pin position
			const triggerPoint = window.innerHeight * 0.2; // 20vh from top

			// Check if we're at the very top (before any content)
			if (window.scrollY < 50) {
				return null; // No active heading at the top
			}

			// Find the heading that should be active
			let candidate: HTMLElement | null = null;

			// Check each heading from top to bottom
			for (let i = 0; i < headings.length; i++) {
				const heading = headings[i];
				const rect = heading.getBoundingClientRect();

				// If heading is above or at the trigger point (20vh)
				if (rect.top <= triggerPoint) {
					candidate = heading;
				} else {
					// Found first heading below trigger point, stop
					break;
				}
			}

			// Special handling for last section:
			// Once the last heading reaches the trigger point, it stays active
			// even if there's more content below (no placeholder needed)
			if (candidate === headings[headings.length - 1]) {
				// Last heading is active, keep it active regardless of scroll position
				return candidate;
			}

			return candidate;
		}

		// Update active heading
		function updateActiveHeading() {
			if (!isUserScrolling) return; // Don't update during programmatic scrolling

			const newActiveHeading = calculateActiveHeading();

			if (newActiveHeading !== activeHeading) {
				activeHeading = newActiveHeading;

				if (activeHeading) {
					setActiveLinkById(activeHeading.id);
					console.log('Active heading:', activeHeading.textContent);
				} else {
					setActiveLinkById(null);
					console.log('No active heading');
				}
			}
		}

		// Handle scroll events
		window.addEventListener('scroll', () => {
			clearTimeout(scrollTimeout);
			isUserScrolling = true;

			scrollTimeout = setTimeout(() => {
				updateActiveHeading();
			}, 50);
		});

		// Initial check (but don't highlight anything on page load)
		setTimeout(() => {
			// Only highlight if user has scrolled from the initial position
			if (window.scrollY > 100) {
				updateActiveHeading();
			}
		}, 500);

		// Smooth scroll behavior for ToC links
		document.querySelectorAll('#toc a').forEach(link => {
			link.addEventListener('click', e => {
				e.preventDefault();
				const targetId = (e.target as HTMLAnchorElement)
					.getAttribute('href')
					?.slice(1);
				if (targetId) {
					const targetElement = document.getElementById(targetId);
					if (targetElement) {
						// Disable user scrolling detection during programmatic scroll
						isUserScrolling = false;

						// Calculate scroll position to place heading at 20vh from top (same as ToC pin point)
						const viewportHeight = window.innerHeight;
						const targetOffset = viewportHeight * 0.2; // 20vh from top - matches ToC trigger
						const elementTop =
							targetElement.getBoundingClientRect().top +
							window.scrollY;
						const scrollToPosition = elementTop - targetOffset;

						// Scroll to the calculated position
						window.scrollTo({
							top: Math.max(0, scrollToPosition),
							behavior: 'smooth'
						});

						// Set active link immediately
						activeHeading = targetElement as HTMLElement;
						setActiveLinkById(targetId);

						// Re-enable user scrolling detection after scroll completes
						clearTimeout(clickTimeout);
						clickTimeout = setTimeout(() => {
							isUserScrolling = true;
						}, 1000); // Wait for smooth scroll to complete
					}
				}
			});
		});
	}

	// Initialize on various load events to handle different navigation scenarios
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializeToC);
	} else {
		// DOM is already loaded
		initializeToC();
	}

	// Also handle Astro's client-side navigation
	document.addEventListener('astro:page-load', initializeToC);

	// Reinitialize on history navigation
	window.addEventListener('popstate', () => {
		setTimeout(initializeToC, 100);
	});
</script>
